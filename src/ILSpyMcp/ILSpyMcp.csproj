<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Set up the NuGet package to be an MCP server -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>

    <!-- Set recommended package metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>ilspymcp</PackageId>
    <Version>1.4.0</Version>
    <ToolCommandName>ilspymcp</ToolCommandName>
    <Authors>Just-Silver</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Just-Silver/ILSpyMcp.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Just-Silver/ILSpyMcp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>AI; MCP; server; stdio; ilspy; decompiler; dotnet</PackageTags>
    <Description>内置 ICSharpCode.Decompiler 的反编译 MCP 服务器，可在对话中直接反编译 .NET 程序集为 C# 源码或列出类型。</Description>
    <!-- PackageReleaseNotes 由 CI（build.yml，打 v* tag 时）注入指向 GitHub Release 页的链接，日志详情看 Release，勿在此硬编码 -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Include additional files for browsing the MCP server. -->
  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.0.0.9375" />
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ILSpyMcp.Tests" />
  </ItemGroup>

</Project>
