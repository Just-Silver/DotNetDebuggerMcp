<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Set up the NuGet package to be an MCP server -->
    <!-- Web SDK 默认 IsPackable=false：不加此行 dotnet pack 仅告警"packaging has been disabled"且退出码 0，静默产出空结果（CI Pack 步骤假绿） -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <!-- 宿主承载 RCL 的 Blazor 组件：.NET 10 框架脚本(blazor.web.js)仅在含 .razor 的 app 引入，
         此处显式要求引入框架静态资产（aspnetcore #58721/#64381：RCL-only host 需此属性） -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>

    <!-- Set recommended package metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>DotNetDebuggerMcp</PackageId>
    <Version>1.8.0</Version>
    <ToolCommandName>DotNetDebuggerMcp</ToolCommandName>
    <!-- U1 UI 自动化：FlaUI 5.0（版本号集中一处；见下方 FlaUI 引用段注释的原理说明） -->
    <FlaUIVersion>5.0.0</FlaUIVersion>
    <Authors>Just-Silver</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Just-Silver/DotNetDebuggerMcp.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Just-Silver/DotNetDebuggerMcp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>AI; MCP; server; stdio; decompiler; debugger; dotnet</PackageTags>
    <Description>内置反编译与调试能力的 .NET MCP 服务器（DotNetDebuggerMcp），可反编译 .NET 程序集或驱动动态调试会话。</Description>
    <!-- PackageReleaseNotes 由 CI（build.yml，打 v* tag 时）注入指向 GitHub Release 页的链接，日志详情看 Release，勿在此硬编码 -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Include additional files for browsing the MCP server. -->
  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" Version="5.1.0" />
    <!-- Microsoft.Extensions.Hosting 不直引：Web SDK 已带 AspNetCore.App 框架引用（内含 Hosting，NU1510） -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <!-- U1 UI 自动化（FlaUI）：PackAsTool 拒绝 platform-qualified TFM，宿主必须保持 net10.0；
       FlaUI 5.0 只发布 net8.0-windows7.0 现代档，net10.0 无法经 PackageReference 消费该资产
       （平台不匹配，只能靠 AssetTargetFallback/压制 NU1701）→ PackageDownload 把 FlaUI 当 path-only
       输入、HintPath 显式绑定兼容程序集（Private=true 保证 dll 随 tool 输出）。
       另显式引用 FlaUI.UIA3 依赖的 Interop.UIAutomationClient 与 System.Management（本仓库无中央包管理，故带版本）。 -->
  <ItemGroup>
    <PackageDownload Include="FlaUI.Core" Version="[$(FlaUIVersion)]" />
    <PackageDownload Include="FlaUI.UIA3" Version="[$(FlaUIVersion)]" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FlaUI.Core" HintPath="$(NuGetPackageRoot)flaui.core\$(FlaUIVersion)\lib\net8.0-windows7.0\FlaUI.Core.dll" Private="true" />
    <Reference Include="FlaUI.UIA3" HintPath="$(NuGetPackageRoot)flaui.uia3\$(FlaUIVersion)\lib\net8.0-windows7.0\FlaUI.UIA3.dll" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetDebugger.Decompiler\DotNetDebugger.Decompiler.csproj" />
    <ProjectReference Include="..\DotNetDebugger.Engine\DotNetDebugger.Engine.csproj" />
    <ProjectReference Include="..\DotNetDebugger.Session\DotNetDebugger.Session.csproj" />
    <ProjectReference Include="..\DotNetDebugger.Web\DotNetDebugger.Web.csproj" />
  </ItemGroup>

  <!-- Web SDK 自带 AspNetCore.App 框架引用与 SWA Root 管线（合并 RCL 静态资产到 _content 路由） -->
  <ItemGroup>
    <InternalsVisibleTo Include="DotNetDebuggerMcp.Tests" />
  </ItemGroup>

</Project>
