@page "/debugger"
@using DotNetDebugger.Engine.Models
@using DotNetDebugger.Web.Services
@inject DocumentStore Store
@implements IDisposable

<PageTitle>调试器</PageTitle>

<div class="d-flex flex-column" style="height:100%;min-height:0;">
<h3 class="mb-2" style="flex:0 0 auto;">动态调试</h3>

<!-- 调试会话控制条 -->
<div class="card mb-2" style="flex:0 0 auto;">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <input @bind="_targetPath" class="form-control form-control-sm" placeholder="目标程序（exe，可带参数），如 DebugTarget.exe 2 8" />
            </div>
            <div class="col-auto">
                <Button IsAsync="true" Color="Color.Primary" Size="Size.Small" OnClick="LaunchTarget">启动并附加</Button>
                <Button IsAsync="true" Color="Color.Secondary" Size="Size.Small" class="ms-1" OnClick="DemoBreakpoint">演示断点+运行</Button>
                <Button IsAsync="true" Color="Color.Danger" Size="Size.Small" class="ms-1" OnClick="Disconnect">断开</Button>
            </div>
            <div class="col-auto ms-auto">
                <Button IsAsync="true" Color="Color.Success" Size="Size.Small" OnClick="StepOver">单步</Button>
                <Button IsAsync="true" Color="Color.Success" Size="Size.Small" class="ms-1" OnClick="StepInto">步入</Button>
                <Button IsAsync="true" Color="Color.Info" Size="Size.Small" class="ms-1" OnClick="ContinueRun">继续</Button>
            </div>
        </div>
    </div>
</div>

<!-- 会话状态 -->
@if (_state is not null)
{
    <div class="alert alert-@(_state == "已停止" ? "warning" : "secondary") py-1 small mb-1" style="flex:0 0 auto;">
        <strong>会话状态：@_state</strong>
        @if (_lastStopText is not null) { <span class="ms-2 text-warning">@_lastStopText</span> }
        @if (_ctrlMessage is not null) { <span class="ms-2 text-info">@_ctrlMessage</span> }
    </div>
}

<!-- 主布局：左类型树 + 右代码/面板（flex 撑满视口剩余，不硬编码高度） -->
<div class="d-flex flex-grow-1" style="min-height:0;gap:8px;">
    <!-- 左：类型浏览树（.tree-view height:100% 需父有确定高度；滚动由 BB .tree-root.scroll 内嵌，勿外包 overflow div） -->
    <div class="d-flex flex-column" style="width:24%;min-width:220px;border:1px solid #dee2e6;border-radius:4px;">
        <div class="small text-secondary px-2 py-1 border-bottom" style="flex:0 0 auto;">类型浏览（agent 反编译过的程序集）</div>
        <div class="flex-grow-1" style="min-height:0;display:flex;flex-direction:column;">
            <TypeTree @ref="_tree" TypeClicked="ShowTypeAsync" MemberClicked="ShowMemberAsync" AssemblyLoaded="OnAssemblyLoaded" OnReady="OnTreeReady" />
        </div>
    </div>
    <!-- 右：代码视图 + 面板 -->
    <div class="d-flex flex-column flex-grow-1" style="min-width:0;min-height:0;">
        <div class="d-flex align-items-center mb-1 small" style="flex:0 0 auto;">
            @if (_loading)
            {
                <span class="text-muted"><i class="fa-solid fa-spin fa-spinner me-1"></i>反编译中，请稍候…</span>
            }
            else if (_doc is { IsSuccess: true } && _doc.Error is null)
            {
                <span class="text-muted">@_doc.AssemblyPath<span class="mx-1 text-secondary">→</span>@_doc.TypeFullName
                    （@_doc.Lines.Length 行，@_doc.Mapping.Count 条映射）</span>
            }
            else if (_doc is not null)
            {
                <span class="text-danger">@_doc.Error</span>
            }
            else
            {
                <span class="text-muted">在左侧树选择类型，或等 agent 反编译时自动跟随</span>
            }
        </div>
        <div class="d-flex flex-grow-1" style="min-height:0;min-width:0;gap:8px;">
            <!-- 代码视图：Monaco 容器必须有确定高度（flex 链落像素）才内部滚动 -->
            <div class="flex-grow-1 d-flex" style="min-width:0;border:1px solid #dee2e6;">
                <CodeViewer @ref="_viewer" CursorLineChanged="OnCursorLineChanged" GlyphClicked="ToggleBreakpointAtLineAsync" />
            </div>
            <!-- 面板列 -->
            <div class="d-flex flex-column" style="width:30%;min-width:220px;overflow:auto;">
                <!-- 调用栈 -->
                <Card HeaderText="@($"调用栈（{_stack.Count}）")" class="mb-2">
                    <BodyTemplate>
                        @if (_stack.Count == 0)
                        {
                            <div class="text-muted small">进程停时显示</div>
                        }
                        else
                        {
                            <div style="max-height:22vh;overflow:auto;">
                                <ListGroup TItem="DebugStackFrame" Items="@_stack.ToList()">
                                    <ItemTemplate>
                                        <div class="@(context.FrameIndex == 0 ? "text-warning fw-bold" : "") small">@context.Location</div>
                                    </ItemTemplate>
                                </ListGroup>
                            </div>
                        }
                    </BodyTemplate>
                </Card>
                <!-- 局部变量（按作用域分组） -->
                <Card HeaderText="局部变量/参数" class="mb-2">
                    <BodyTemplate>
                        @if (_variables.Count == 0)
                        {
                            <div class="text-muted small">进程停时显示</div>
                        }
                        else
                        {
                            <div style="max-height:22vh;overflow:auto;">
                                @foreach (var (scope, vars) in _variables)
                                {
                                    <div class="small text-secondary mt-1">[@scope]</div>
                                    <ListGroup TItem="DebugVariable" Items="@vars.ToList()">
                                        <ItemTemplate>
                                            <div class="small font-monospace">@(context.Name ?? $"slot{context.Slot}") = @context.Value.Display</div>
                                        </ItemTemplate>
                                    </ListGroup>
                                }
                            </div>
                        }
                    </BodyTemplate>
                </Card>
                <!-- 线程 -->
                <Card HeaderText="@($"线程（{_threads.Count}）")">
                    <BodyTemplate>
                        @if (_threads.Count == 0)
                        {
                            <div class="text-muted small">进程停时显示</div>
                        }
                        else
                        {
                            <div style="max-height:15vh;overflow:auto;">
                                <ListGroup TItem="DebugThreadInfo" Items="@_threads.ToList()">
                                    <ItemTemplate>
                                        <div class="small font-monospace @(context.ThreadId == _debug.Active?.Buffer.StoppedThreadId ? "text-warning fw-bold" : "")">
                                            thread @context.ThreadId@(context.ThreadId == _debug.Active?.Buffer.StoppedThreadId ? " (停)" : "")
                                        </div>
                                    </ItemTemplate>
                                </ListGroup>
                            </div>
                        }
                    </BodyTemplate>
                </Card>
            </div>
        </div>
    </div>
    <!-- 最右：轨迹时间线（上）+ 内存日志（下），各半列（联调诊断） -->
    <div class="d-flex flex-column" style="width:20%;min-width:200px;max-width:320px;border:1px solid #dee2e6;border-radius:4px;">
        <div class="d-flex flex-column" style="flex:1 1 50%;min-height:0;">
            <AgentTimeline />
        </div>
        <div class="d-flex flex-column" style="flex:1 1 50%;min-height:0;border-top:1px solid #dee2e6;">
            <LogPanel />
        </div>
    </div>
</div>
</div>
