@inherits LayoutComponentBase

<BootstrapBlazorRoot>
    <Layout IsPage="true" ShowFooter="false" SideWidth="0">
        <Header>
            <div class="d-flex align-items-center w-100">
                <span class="ms-3 flex-grow-1">DotNet Debugger Web</span>
                <ThemeProvider />
            </div>
        </Header>
        <Main>
            <div class="d-flex flex-column" style="height: calc(var(--bb-layout-height, 100vh) - var(--bb-layout-header-height, 50px)); padding: 1rem;">
                @Body
            </div>
        </Main>
    </Layout>
</BootstrapBlazorRoot>
