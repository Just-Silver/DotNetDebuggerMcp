<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DotNetDebugger.Web</RootNamespace>
    <!-- RCL 类库（被宿主承载）：Razor SDK 以 Default 模式参与静态资产管线，
         资产暴露为 _content/DotNetDebugger.Web/ 前缀（Web SDK 会误判 Root 模式丢失前缀） -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- Monaco 资产自带内容哈希名，排除出 MapStaticAssets 清单（避免二次指纹化致 AMD 按原哈希名
         请求返回 200 空 body，aspnetcore #66833），由宿主 UseStaticFiles 服务原文件 -->
    <StaticWebAssetEndpointExclusionPattern>$(StaticWebAssetEndpointExclusionPattern);lib/monaco-editor/**</StaticWebAssetEndpointExclusionPattern>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BootstrapBlazor" Version="10.*" />
    <!-- Fluent UI 主题（覆盖默认 Bootstrap 皮肤，微软风；默认暗色经 data-bs-theme="dark"） -->
    <PackageReference Include="BootstrapBlazor.Theme.Fluent" Version="10.*" />
    <!-- FontAwesome 图标字体：BB 默认 IconTheme 是 fa，TreeView 箭头等图标 class 为 fa-solid fa-*，
         缺此包则图标字体不加载、箭头/图标渲染空白（官方 demo 亦显式引用） -->
    <PackageReference Include="BootstrapBlazor.FontAwesome" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetDebugger.Session\DotNetDebugger.Session.csproj" />
    <ProjectReference Include="..\DotNetDebugger.Decompiler\DotNetDebugger.Decompiler.csproj" />
  </ItemGroup>

</Project>
